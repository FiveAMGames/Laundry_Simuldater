%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3020ea3d401a75418e3c9e0b18e13aa, type: 3}
  m_Name: Char1
  m_EditorClassIdentifier: 
  CharName: Char 1
  CharIndex: 0
  CharPortraitDefault: {fileID: 21300000, guid: c0790ce9f70184892aff3bc36fe3ad29, type: 3}
  CharPortraitHappy: {fileID: 21300000, guid: bd56b9f129c20c1478503fd7af2e001b, type: 3}
  CharPortraitSad: {fileID: 21300000, guid: eaaa97d24254a004da8c872928ddd41e, type: 3}
  CharPortraitFlirty: {fileID: 21300000, guid: 29d35bf810421de409150cb541af3f77, type: 3}
  GoodWork: Positively divine! You did a wonderful job, my Dear!
  BadWork: Sloppy handywork, my Dear. Let's hope you'll do better next time.
  AllDialogs:
  - dayIndex: 0
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 0}
        DialogPart:
        - TextPartID: char1_day1_part1
          text: Greetings, Mortal. My servants tell me I can get my attire cleaned
            in this esteemed... establishment?
          animation: default
          TextPartResponses:
          - ResponceTextID: char1_day1_part1_responce1
            text: (Dry) Correct, I clean clothes.
            ResponcePoints: 1
          - ResponceTextID: char1_day1_part1_responce2
            text: (Bubbly) Yes, silly! Didn't you see the huge neon sign that says
              "Clean for the Mean"?
            ResponcePoints: -1
          - ResponceTextID: char1_day1_part1_responce3
            text: (Fresh) Nice, looks like word of my "esteemed establishment" got
              around.
            ResponcePoints: 0
        - TextPartID: char1_day1_part2
          text: Indeed. Would you be able to return this shirt to its original, pristine
            condition?
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day1_part3
          text: Tell me, are you experienced in cleaning blood stains?
          animation: happy
          TextPartResponses:
          - ResponceTextID: char1_day1_part3_responce1
            text: (Dry) I'm in business with evil. Getting rid of blood is my bread
              and butter.
            ResponcePoints: 0
          - ResponceTextID: char1_day1_part3_responce2
            text: (Bubbly) Oh, that's a big one! The other guy didn't live to tell
              the tale, I imagine. Good on you!
            ResponcePoints: 1
          - ResponceTextID: char1_day1_part3_responce3
            text: (Fresh) Blood? That looks more like wine to me, Pookie.
            ResponcePoints: -1
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 0}
        DialogPart:
        - TextPartID: char1_day1_part4_lowPoints
          text: It's a big stain and I can assure you it's blood. Blood indeed.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day1_part5_lowPoints
          text: And not wine at all...
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day1_part6_lowPoints
          text: I should know, I'm a Vampire Elder. Baronex Duskmantle of Midnight's
            Keep to be exact.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day1_part6_lowPoints_responce1
            text: (Dry) It smells like wine, it looks like wine. I will treat it
              like wine.
            ResponcePoints: -1
          - ResponceTextID: char1_day1_part6_lowPoints_responce2
            text: (Bubbly) But it smells like... Ooh, got it. Of course dear Baronex,
              I will totally get rid of this BLOOD stain for you!
            ResponcePoints: 1
          - ResponceTextID: char1_day1_part6_lowPoints_responce3
            text: (Fresh) Whatever the stain, I'll make sure to get that shirt back
              on you asap.
            ResponcePoints: 0
        - TextPartID: char1_day1_part7_lowPoints
          text: I shall return to collect the garment tomorrow. I hope your services
            will please my sophisticated taste.
          animation: flirty
          TextPartResponses: []
      - MinPointsForDialog: {x: 1, y: 10}
        DialogPart:
        - TextPartID: char1_day1_part4_highPoints
          text: It's a big stain and I can assure you it's blood. Blood indeed.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day1_part5_highPoints
          text: My victim lost a lot of it when I fed on them last night. I'm a Vampire
            Elder, you see.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char1_day1_part6_highPoints
          text: "Baronex Duskmantle of Midnight's Keep to be exact. Enchant\xE9..."
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day1_part7_highPoints
          text: Pray do tell, have you ever worked for a Vampire before? Most common
            folk find us most... frightening.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day1_part7_highPoints_responce1
            text: (Dry) Most my clientele is dangerous. I am confident my excellent
              services will keep me in business. And alive.
            ResponcePoints: 1
          - ResponceTextID: char1_day1_part7_highPoints_responce2
            text: (Bubbly) A real Vampire Elder? I'm positively thrilled! But don't
              worry. I'm not scared. Most my clients are kinda dangerous.
            ResponcePoints: 0
          - ResponceTextID: char1_day1_part7_highPoints_responce3
            text: (Fresh) I got many dangerous customers but none look as sharp as
              you. The bloodlust suits you well.
            ResponcePoints: -1
        - TextPartID: char1_day1_part8_highPoints
          text: You are a gutsy one! Living here amongst such murderous creatures
            can't be easy.
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day1_part9_highPoints
          text: Sometimes even a Vampire can feel discouraged around such marvelous
            villainy.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day1_part10_highPoints
          text: Especially if this theoretical Vampire was inept at hunting prey...
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day1_part11_highPoints
          text: Which is not me, of course! I'm an exceptional hunterex! Confirmed
            by the blood stains on my shirt which are NOT wine at all.
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day1_part12_highPoints
          text: I'm looking forward to collect my garment tomorrow. And to see you
            again, dear Mortal.
          animation: flirty
          TextPartResponses: []
  - dayIndex: 1
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 100}
        DialogPart:
        - TextPartID: char1_day2_part1
          text: Gree...tings. Mo- mo... ortal...
          animation: sad
          TextPartResponses:
          - ResponceTextID: char1_day2_part1_responce1
            text: (Dry) Hello.
            ResponcePoints: 0
          - ResponceTextID: char1_day2_part1_responce2
            text: (Bubbly) Are you okay? Do you need a glass of water? Or uhm, a
              goblet of blood?
            ResponcePoints: 1
          - ResponceTextID: char1_day2_part1_responce3
            text: (Fresh) Damn, what got you lookin' all sweaty?
            ResponcePoints: -1
        - TextPartID: char1_day2_part2
          text: I ju... I just went for a nice evening... stroll.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day2_part3
          text: A stroll that included vigorous running and jumping. And a very small
            tumble on my part.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day2_part3_1
          text: If you could take care of my hunting cloak, I would be most obliged.
          animation: happy
          TextPartResponses:
          - ResponceTextID: char1_day2_part3_responce1
            text: (Dry) Maybe you shouldn't hunt. Successful vampires let their prey
              come to them.
            ResponcePoints: -1
          - ResponceTextID: char1_day2_part3_responce2
            text: (Bubbly) Oh gosh... Maybe you should let people come to you in
              the future instead of running after them.
            ResponcePoints: 0
          - ResponceTextID: char1_day2_part3_responce3
            text: (Fresh) Why do you need to go hunting anyway? Throw a party or
              something. I'm sure people would come in flocks.
            ResponcePoints: 1
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 3}
        DialogPart:
        - TextPartID: char1_day2_part4_lowPoints
          text: Thank you for your... input. But let's focus on the task at hand.
            My hunting cloak!
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day2_part5_lowPoints
          text: There are some grass stains on it and sweat.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day2_part6_lowPoints
          text: But it's not my sweat! That would be quite unbecoming of a Vampire
            Elder of my standing.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day2_part6_lowPoints_responce1
            text: (Dry) The sweat of your victim, perhaps?
            ResponcePoints: 1
          - ResponceTextID: char1_day2_part6_lowPoints_responce2
            text: (Bubbly) Awww, but it's not embarrassing to be a little sweaty.
              It happens to all of us.
            ResponcePoints: 0
          - ResponceTextID: char1_day2_part6_lowPoints_responce3
            text: (Fresh) Yeah, sure. That's also why your forehead is NOT covered
              in sweat.
            ResponcePoints: -1
        - TextPartID: char1_day2_part7_lowPoints
          text: Just clean it please. That's what I'm paying you for, isn't it.
          animation: default
          TextPartResponses: []
      - MinPointsForDialog: {x: 3, y: 100}
        DialogPart:
        - TextPartID: char1_day2_part4_highPoints
          text: My sweet Mortal, that is indeed a splendid suggestion!
          animation: flirty
          TextPartResponses: []
        - TextPartID: char1_day2_part5_highPoints
          text: "I shall try it. A dinner party perhaps, or a soir\xE9e, or even...
            a cheeky get-together."
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day2_part6_highPoints
          text: I'd invite YOU of course but alas, you need to clean my cloak. I
            apologize, dear One.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day2_part7_highPoints
          text: I think there is a grass stain from my tumble and some sweat.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day2_part8_highPoints
          text: Please don't tell anyone that I can actually sweat. That would break
            my dark, unbeating heart.
          animation: sad
          TextPartResponses:
          - ResponceTextID: char1_day2_part8_highPoints_responce1
            text: (Dry) I have no interest in gossiping.
            ResponcePoints: 1
          - ResponceTextID: char1_day2_part8_highPoints_responce2
            text: (Bubbly) Aww, but why not? I think it would make you more approachable!
            ResponcePoints: -1
          - ResponceTextID: char1_day2_part8_highPoints_responce3
            text: (Fresh) Yeah, I won't tell anyone. Probably...
            ResponcePoints: 0
        - TextPartID: char1_day2_part9_highPoints
          text: I trust you won't tell anyone for you haven't given me any reason
            to doubt you.
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day2_part10_highPoints
          text: I can't wait to see you again, my Dear.
          animation: flirty
          TextPartResponses: []
  - dayIndex: 2
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 100}
        DialogPart:
        - TextPartID: char1_day3_part1
          text: You are a proper genius, sweet Mortal. I did what you recommended.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char1_day3_part2
          text: I hosted a lavishly decadent tupperware party. They practically BEGGED
            me to grant them entrance.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day3_part3
          text: Like sheep to the slaughter. It was positively divine!
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day3_part4
          text: And I picked the plumpest one to join me for the after party... The
            blood on my silken night-blouse is that was left of her.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day3_part4_responce1
            text: (Dry) Sounds like a successful night.
            ResponcePoints: 0
          - ResponceTextID: char1_day3_part4_responce2
            text: (Bubbly) Oh, it sounds wonderful! I'm so sad I missed it. Especially
              the after party.
            ResponcePoints: 1
          - ResponceTextID: char1_day3_part4_responce3
            text: (Fresh) Your silken night-blouse? A tupperware party??? Come on
              dude, where's the carnage?
            ResponcePoints: -1
        - TextPartID: char1_day3_part5
          text: It was a titillating night... I haven't indulged in the pleasures
            of flesh and blood in a long time.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day3_part6
          text: You'll discover stains of my favorite massage oils on there too.
            We were utterly naughty before, well... I killed her.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day3_part6_responce1
            text: (Dry) I really, REALLY do not wish to hear more about your titillating
              night.
            ResponcePoints: -1
          - ResponceTextID: char1_day3_part6_responce2
            text: (Bubbly) Sounds like you had a lovely night. Her too, up until
              the end at least.
            ResponcePoints: 0
          - ResponceTextID: char1_day3_part6_responce3
            text: (Fresh) Yeah, that's more like it! Tell me more about the blood.
              Was it gushing? Splattering?
            ResponcePoints: 1
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 4}
        DialogPart:
        - TextPartID: char1_day3_part7_lowPoints
          text: I don't want to bore you with any more details. Just know, the night
            was a big success, thanks to you.
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day3_part8_lowPoints
          text: Maybe I'll invite you to one of my parties one day.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day3_part8_lowPoints_responce1
            text: (Dry) I will decline.
            ResponcePoints: -1
          - ResponceTextID: char1_day3_part8_lowPoints_responce2
            text: '(Bubbly) That would be amazing. I love parties, tupperware, and
              sexy vampires! '
            ResponcePoints: 1
          - ResponceTextID: char1_day3_part8_lowPoints_responce3
            text: (Fresh) I might show up, as long as it isn't a fucking tupperware
              party.
            ResponcePoints: 0
        - TextPartID: char1_day3_part9_lowPoints
          text: We'll see what the future brings... Or at least I will. You humans
            have preposterously short life-spans, right?
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day3_part10_lowPoints
          text: Especially if there are ravenous vampires lurking around. Vampires
            that just got reminded of the sweet taste of blood.
          animation: flirty
          TextPartResponses: []
      - MinPointsForDialog: {x: 4, y: 100}
        DialogPart:
        - TextPartID: char1_day3_part7_highPoints
          text: I don't want to bore you with any more details. Just know, the night
            was a big success. Thanks to you, my Dear.
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day3_part8_highPoints
          text: There was a one thing though that left a bad taste in my mouth after
            all.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day3_part9_highPoints
          text: I was missing you, my Dear. Your wit, your dauntlessness, your bewitching
            eyes...
          animation: default
          TextPartResponses: []
        - TextPartID: char1_day3_part10_highPoints
          text: Thoughts of you follow me, wherever I go. Like the scent of detergent,
            softly lingering in the ether.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char1_day3_part10_highPoints_responce1
            text: (Dry) And just like ink on a white shirt, you will never get rid
              of me.
            ResponcePoints: 1
          - ResponceTextID: char1_day3_part10_highPoints_responce2
            text: (Bubbly) Did you just compare me to... laundry detergent? That's
              not how you romance a hottie like me.
            ResponcePoints: -1
          - ResponceTextID: char1_day3_part10_highPoints_responce3
            text: (Fresh) You lost me with the detergent thing, sorry. Don't you
              wanna talk about blood again?
            ResponcePoints: 0
        - TextPartID: char1_day3_part11_highPoints
          text: That is the dauntlessness I was talking about. Who would dare to
            speak to a Vampire Elder that way?
          animation: happy
          TextPartResponses: []
        - TextPartID: char1_day3_part12_highPoints
          text: I take great delight in your company and in being your customer.
            I am certain that you will get rid of these oil and blood stains.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char1_day3_part13_highPoints
          text: But I'm also plagued by dark thoughts, my Dear.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day3_part14_highPoints
          text: To know that you, a human, will have to perish one day... Accepting
            that feels almost insurmountable.
          animation: sad
          TextPartResponses: []
        - TextPartID: char1_day3_part15_highPoints
          text: But regardless, I will leave you to your work. I'm sure I will be
            greatly satisfied as always, dear One.
          animation: flirty
          TextPartResponses: []
