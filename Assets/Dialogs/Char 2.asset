%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f3020ea3d401a75418e3c9e0b18e13aa, type: 3}
  m_Name: Char 2
  m_EditorClassIdentifier: 
  CharName: Char 1
  CharIndex: 1
  CharPortraitDefault: {fileID: 21300000, guid: b27152bc53a894aff9204c0ce406890f, type: 3}
  CharPortraitHappy: {fileID: 21300000, guid: 05d58173a8320824cadaafb4477f30b5, type: 3}
  CharPortraitSad: {fileID: 21300000, guid: 505e05d049103ce43aa140f3aaa30100, type: 3}
  CharPortraitFlirty: {fileID: 21300000, guid: 82d1d50ae56e06646b53464f00f28cee, type: 3}
  GoodWork: Fuck me! That's what I call a job well done.
  BadWork: That looks a bit shit. Do better next time, soap-nerd!
  AllDialogs:
  - dayIndex: 0
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 0}
        DialogPart:
        - TextPartID: char2_day1_part1
          text: Hey, you the one doin' laundry, right?
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day1_part2
          text: I got some oil on this work-overall. Can you get it out?
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day1_part2_responce1
            text: (Dry) Certainly. Looks like motor oil. Shouldn't be a problem.
            ResponcePoints: 0
          - ResponceTextID: char2_day1_part2_responce2
            text: (Bubbly) Sticky stuff, but I can get it out. I don't want a cutie
              like you running around with motor oil stains.
            ResponcePoints: -1
          - ResponceTextID: char2_day1_part2_responce3
            text: (Fresh) Motor oil, synthetic blend. Stubborn, but I'll get it out.
            ResponcePoints: 1
        - TextPartID: char2_day1_part3
          text: Yeah, I needed to fix somethin' on my Mistress's orbital laser.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day1_part4
          text: Got quite dirty in the process.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day1_part5
          text: 'You know how Super Villains are: The bigger the laser, the better.'
          animation: default
          TextPartResponses: []
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 0}
        DialogPart:
        - TextPartID: char2_day1_part6_lowPoints
          text: 'Yeah, whatever... I need this overall cleaned. '
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day1_part8_lowPoints
          text: She is quite...
          animation: happy
          TextPartResponses:
          - ResponceTextID: char2_day1_part8_lowPoints_responce1
            text: (Dry) ...
            ResponcePoints: 0
          - ResponceTextID: char2_day1_part8_lowPoints_responce2
            text: (Bubbly) Cool?
            ResponcePoints: -1
          - ResponceTextID: char2_day1_part8_lowPoints_responce3
            text: (Fresh) Incompetent? Annoying?
            ResponcePoints: 1
        - TextPartID: char2_day1_part9_lowPoints
          text: Demanding.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day1_part10_lowPoints
          text: Anyway, I'm out. Do your job well and I'll return with more shit
            to clean.
          animation: default
          TextPartResponses: []
      - MinPointsForDialog: {x: 1, y: 10}
        DialogPart:
        - TextPartID: char2_day1_part6_highPoints
          text: You sound like you know what you're talking about. I respect that.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day1_part7_highPoints
          text: These higher-ups act like they are the shit but they don't know that
            people like us make the world go round.
          animation: sad
          TextPartResponses: []
        - TextPartID: char2_day1_part8_highPoints
          text: I'll be a good customer for you, ya know. My Mistress has me climb
            in all sort of shit.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day1_part9_highPoints
          text: So I have a lot of laundry that needs taking care of.
          animation: flirty
          TextPartResponses:
          - ResponceTextID: char2_day1_part9_highPoints_responce1
            text: (Dry) I always take care of my customers.
            ResponcePoints: 0
          - ResponceTextID: char2_day1_part9_highPoints_responce2
            text: (Bubbly) I'd love to take care of you- ehm... Of your clothing.
            ResponcePoints: 1
          - ResponceTextID: char2_day1_part9_highPoints_responce3
            text: (Fresh) Just don't bring in anything too nasty. I don't do contagious
              stuff.
            ResponcePoints: -1
        - TextPartID: char2_day1_part10_highPoints
          text: Right. Just get that oil stain out and I'll be happy as a clam.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day1_part11_highPoints
          text: And trust me, you don't want to see me unhappy.
          animation: default
          TextPartResponses: []
  - dayIndex: 1
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 100}
        DialogPart:
        - TextPartID: char2_day2_part1
          text: Ugh...
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day2_part1_responce1
            text: (Dry) Hello.
            ResponcePoints: -1
          - ResponceTextID: char2_day2_part1_responce2
            text: (Bubbly) Oh, you look kinda sad. What's wrong?
            ResponcePoints: 0
          - ResponceTextID: char2_day2_part1_responce3
            text: (Fresh) You look like shit. What happened?
            ResponcePoints: 1
        - TextPartID: char2_day2_part2
          text: Being a henchwoman is just the fucking worst. I can deal with the
            dirt, the insults, the violence, even the irregular working hours.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day2_part3
          text: But the evil schemes this woman comes up with... They're just dumb!
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day2_part3_responce1
            text: (Dry) Sounds like you should get rid of her. Or replace her.
            ResponcePoints: 1
          - ResponceTextID: char2_day2_part3_responce2
            text: (Bubbly) Oh, that's horrible. I'm sorry to hear... You should switch
              roles with her. That'll teach her.
            ResponcePoints: 0
          - ResponceTextID: char2_day2_part3_responce3
            text: (Fresh) Usually henchwomen don't complain so much. Maybe you should
              become a villain instead.
            ResponcePoints: -1
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 4}
        DialogPart:
        - TextPartID: char2_day2_part4_lowPoints
          text: Me replacing her? Tss, that's not how it works, soap-nerd.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day2_part5_lowPoints
          text: Anyway, my Mistress' last ingenious plan was to punish the pizza-guy
            next to our secret lair.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day2_part6_lowPoints
          text: He discontinued her favorite pizza, so she kidnapped his baby.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day2_part7_lowPoints
          text: 'Now I have to watch that brat until the guy surrenders or dies or
            whatever. Fucking GREAT idea, if you ask me. '
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day2_part7_lowPoints_responce1
            text: (Dry) I didn't ask. But that explains the stains.
            ResponcePoints: 0
          - ResponceTextID: char2_day2_part7_lowPoints_responce2
            text: (Bubbly) Ah baby?! Omg that's sooo cute!
            ResponcePoints: -1
          - ResponceTextID: char2_day2_part7_lowPoints_responce3
            text: (Fresh) So you have to take care of the baby now? Gross...
            ResponcePoints: 1
        - TextPartID: char2_day2_part8_lowPoints
          text: It's fucking annyoing... I got drool and babyfood stains all over
            my work-clothes.
          animation: sad
          TextPartResponses: []
        - TextPartID: char2_day2_part9_lowPoints
          text: But that's your problem now. Take care of it for me, okay sweetcheeks?
          animation: happy
          TextPartResponses: []
      - MinPointsForDialog: {x: 4, y: 100}
        DialogPart:
        - TextPartID: char2_day2_part4_highPoints
          text: You think I should become a Super Villain? That's insane... But maybe
            you're on to something.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day2_part5_highPoints
          text: I sure as fuck would be better at making evil plans. You know what
            she did?
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day2_part6_highPoints
          text: She was angry at the pizza-guy next door because he discontinued
            her favorite pizza.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day2_part7_highPoints
          text: She could've blown up the shop, poisoned the marinara sauce, cut
            off his fingers, anything...
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day2_part8_highPoints
          text: But she decided to kidnap his baby. And now I have to take care of
            it.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day2_part9_highPoints
          text: I mean, look at my clothes! They're full of baby food and drool!!!
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day2_part9_highPoints_responce1
            text: (Dry) I'll just clean the stains for you, I don't need a backstory.
            ResponcePoints: -1
          - ResponceTextID: char2_day2_part9_highPoints_responce1
            text: (Dry) I'll just clean the stains for you, I don't need a backstory.
            ResponcePoints: 1
          - ResponceTextID: char2_day2_part9_highPoints_responce1
            text: (Dry) I'll just clean the stains for you, I don't need a backstory.
            ResponcePoints: 0
        - TextPartID: char2_day2_part10_highPoints
          text: Anyway, what's done is done. And I need you to get these stains out.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day2_part11_highPoints
          text: I'm glad I can count on you. You really are good at your job, soap-nerd.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day2_part12_highPoints
          text: I got a thing for nerds, ya know. I like how they get nervous and
            shit. It's cute.
          animation: flirty
          TextPartResponses: []
  - dayIndex: 2
    DialogParts:
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 100}
        DialogPart:
        - TextPartID: char2_day3_part1
          text: Yo, I did it! I got rid of that incompetent roach of a Super Villain.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day3_part2
          text: I didn't kill her or anything. I just locked her in one of her torture-labyrinths.
            Which I built FIY.
          animation: sad
          TextPartResponses: []
        - TextPartID: char2_day3_part3
          text: She'll never find her way out of it, ha! And I'm the new Villain
            in town.
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day3_part4
          text: I got a Super Villain overall now too. I don't fuck with spandex.
          animation: happy
          TextPartResponses:
          - ResponceTextID: char2_day3_part4_responce1
            text: (Dry) A bit uninspired but overalls are easier to clean anyway.
            ResponcePoints: 0
          - ResponceTextID: char2_day3_part4_responce2
            text: (Bubbly) An overall? Really? Isn't that a bit boring? There are
              such cool spandex suits out there...
            ResponcePoints: -1
          - ResponceTextID: char2_day3_part4_responce3
            text: (Fresh) So what do you fuck with?
            ResponcePoints: 1
        - TextPartID: char2_day3_part5
          text: Well, I... Wanted to talk about the stains on my overall, actually.
            Look, there's a bunch of sweat and blood on it.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part6
          text: I like the look of it but this thing reaks. I need it cleaned before
            I execute my next evil plan. Which...
          animation: happy
          TextPartResponses:
          - ResponceTextID: char2_day3_part6_responce1
            text: (Dry) I do not wish to hear your evil plan. I will not be an accessory
              to a crime.
            ResponcePoints: -1
          - ResponceTextID: char2_day3_part6_responce2
            text: (Bubbly) Oh, yes! Tell me your evil plan. I NEED to know!!!
            ResponcePoints: 1
          - ResponceTextID: char2_day3_part6_responce3
            text: (Fresh) Oh sick, are you seriously gonna tell me your evil plan?
              Isn't that usually a secret or something?
            ResponcePoints: 0
    - VariantDialogs:
      - MinPointsForDialog: {x: 0, y: 9}
        DialogPart:
        - TextPartID: char2_day3_part7_lowPoints
          text: You know what, nevermind. I'm not gonna tell you my plan.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part8_lowPoints
          text: Which I definitely have. And that is super elaborate and like super
            dark and twisted...
          animation: sad
          TextPartResponses:
          - ResponceTextID: char2_day3_part8_lowPoints_responce1
            text: (Dry) Okay.
            ResponcePoints: 0
          - ResponceTextID: char2_day3_part8_lowPoints_responce2
            text: (Bubbly) Aw man... You sure? I bet it IS really cool and elaborate
              and twisted.
            ResponcePoints: 1
          - ResponceTextID: char2_day3_part8_lowPoints_responce3
            text: (Fresh) That's so lame, dude. Why tease it then?
            ResponcePoints: -1
        - TextPartID: char2_day3_part9_lowPoints
          text: Maybe it was my PLAN to have you guess. Ya know, another scheme from
            the Blue Collared Menace.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day3_part10_lowPoints
          text: Which is my Super Villain name btw. Blue... Collared... Menace...
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day3_part11_lowPoints
          text: So get these stains out or my next plan might involve a certain laundry
            shop.
          animation: default
          TextPartResponses: []
      - MinPointsForDialog: {x: 9, y: 100}
        DialogPart:
        - TextPartID: char2_day3_part7_highPoints
          text: Actually, I don't really have an evil plan yet.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part8_highPoints
          text: Turns out, I'm a great henchwoman but a fucking horrible schemer.
          animation: sad
          TextPartResponses: []
        - TextPartID: char2_day3_part9_highPoints
          text: My old Mistress was terrible at it too, don't get me wrong. But it's
            actually a lot harder than I thought.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part10_highPoints
          text: That's also the reason I came to you. I feel like you're smart.
          animation: happy
          TextPartResponses: []
        - TextPartID: char2_day3_part11_highPoints
          text: And being a business-person or whatever is not easy. Not in this
            shit economy.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part12_highPoints
          text: Sooo, what I'm saying is... Do you maybe wanna work together sometime?
          animation: flirty
          TextPartResponses: []
        - TextPartID: char2_day3_part13_highPoints
          text: I know you got your laundry thing going and I still need you to get
            rid of these blood and sweat stains.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part14_highPoints
          text: But maybe you have time for a little side hustle?
          animation: happy
          TextPartResponses:
          - ResponceTextID: char2_day3_part14_highPoints_responce1
            text: (Dry) Interesting proposition. Maybe I do have time for a side
              hustle in crime.
            ResponcePoints: 1
          - ResponceTextID: char2_day3_part14_highPoints_responce2
            text: (Bubbly) Working together with you sounds fun! But I'm more of
              a lover than a fighter, I think.
            ResponcePoints: 0
          - ResponceTextID: char2_day3_part14_highPoints_responce3
            text: (Fresh) So I'm supposed to be your henchling? Fuck no...
            ResponcePoints: -1
        - TextPartID: char2_day3_part15_highPoints
          text: In any case, you helped me out last time. Saying I should replace
            my Ex-Mistress and all.
          animation: default
          TextPartResponses: []
        - TextPartID: char2_day3_part16_highPoints
          text: For a nerd, you're kinda cool. And you smell like soap. I like that.
          animation: happy
          TextPartResponses: []
